#!/bin/sh
export LANG=C

# Signals to emit inside AwesomeWM

# sound::sink::volume
SIG_VOL_SINK="sound::sink::volume"
# sound::sink::mute
SIG_MUTE_SINK="sound::sink::mute"
# sound::sink::port
SIG_PORT_SINK="sound::sink::port"

# sound::source::volume
SIG_VOL_SOURCE="sound::source::volume"
# sound::source::mute
SIG_MUTE_SOURCE="sound::source::mute"
# sound::source::port
SIG_PORT_SOURCE="sound::source::port"

# State trackers to avoid redundant transmissions

SINK_VOL=""
SINK_MUTE=""
SINK_PORT=""
SOURCE_VOL=""
SOURCE_MUTE=""
SOURCE_PORT=""

STATE_DIR="${XDG_RUNTIME_DIR}/awesome/sound"
STATE_FILE="${STATE_DIR}/${XDG_SESSION_ID}.status"

if [ ! -d "$STATE_DIR" ]; then
    mkdir -p "$STATE_DIR"
fi

: > "$STATE_FILE"

client_name="awesome-sound-id-${XDG_SESSION_ID}"

# kill other instances if they exist
pkill --full "pactl --client-name=$client_name subscribe" 2>/dev/null

send_awesome_signal() {
    awesome-client "awesome.emit_signal('$1', '$2')" >/dev/null 2>&1
    # printf '%s\n' "emitting '$1' with value '$2'"
}

get_def_dev() {
    pactl "get-default-${1}"
}

write_state_vars() {
    {
        printf '%=%s\n' 'SINK_VOL'    "$SINK_VOL"
        printf '%=%s\n' 'SINK_MUTE'   "$SINK_MUTE"
        printf '%=%s\n' 'SINK_PORT'   "$SINK_PORT"
        printf '%=%s\n' 'SOURCE_VOL'  "$SOURCE_VOL"
        printf '%=%s\n' 'SOURCE_MUTE' "$SOURCE_MUTE"
        printf '%=%s\n' 'SOURCE_PORT' "$SOURCE_PORT"
    } > "$STATE_FILE"
}

# Queries and streams changes for a device type (sink or source)
update_device_state() {
    type="$1"       # "sink" or "source"

    # Get current default device name
    def_dev=$(get_def_dev "$type")
    [ -z "$def_dev" ] && return

    # Parse specific device characteristics
    in_device=0
    cur_vol=""
    cur_mute=""
    cur_port=""

    pactl list "${type}s" | {
        while read -r line; do
            case "$line" in
                Name:*)
                    if [ "${line#*: }" = "$def_dev" ]; then
                        in_device=1
                    else
                        in_device=0
                    fi
                    ;;
            esac

            if [ "$in_device" -eq 1 ]; then
                case "$line" in
                    "Volume:"*)
                        cur_vol=$(echo "$line" | grep -oE '[0-9]+%' | head -n1 | tr -d '%')
                        ;;
                    "Mute:"*)
                        cur_mute=${line#*: }
                        ;;
                    "Active Port:"*)
                        cur_port=${line#*: }
                        ;;
                esac
            fi
        done

        # Conditionally emit changed values
        if [ "$type" = "sink" ]; then
            if [ "$cur_vol" != "$SINK_VOL" ] && [ ! -z "$cur_vol" ]; then
                send_awesome_signal "$SIG_VOL_SINK" "$cur_vol"
                SINK_VOL="$cur_vol"
            fi
            if [ "$cur_mute" != "$SINK_MUTE" ] && [ ! -z "$cur_mute" ]; then
                send_awesome_signal "$SIG_MUTE_SINK" "$cur_mute"
                SINK_MUTE="$cur_mute"
            fi
            if [ "$cur_port" != "$SINK_PORT" ] && [ ! -z "$cur_port" ]; then
                send_awesome_signal "$SIG_PORT_SINK" "$cur_port"
                SINK_PORT="$cur_port"
            fi
        elif [ "$type" = "source" ]; then
            if [ "$cur_vol" != "$SOURCE_VOL" ] && [ ! -z "$cur_vol" ]; then
                send_awesome_signal "$SIG_VOL_SOURCE" "$cur_vol"
                SOURCE_VOL="$cur_vol"
            fi
            if [ "$cur_mute" != "$SOURCE_MUTE" ] && [ ! -z "$cur_mute" ]; then
                send_awesome_signal "$SIG_MUTE_SOURCE" "$cur_mute"
                SOURCE_MUTE="$cur_mute"
            fi
            if [ "$cur_port" != "$SOURCE_PORT" ] && [ ! -z "$cur_port" ]; then
                send_awesome_signal "$SIG_PORT_SOURCE" "$cur_port"
                SOURCE_PORT="$cur_port"
            fi
        fi
    }
}

update_all() {
    update_device_state "sink"
    update_device_state "source"
}

main() {
    pactl --client-name="$client_name" subscribe 2>/dev/null | \
    grep --line-buffered -E "Event 'change' on (sink|source) #" | \
    while read -r event; do
        printf '%s\n' "$event"
        update_all
    done
}

# Run an initial bootstrap pass
update_all

main >/dev/null 2>&1
